<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Startskärm från Android 12: kopparlogotyp på blå bakgrund och Kodhästs ordmärke längst ner (UI-17).
         Ordmärket är android-ui:s @drawable/kodhast_branding i färgerna från values/colors.xml. -->
    <style name="Theme.Fonder.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_splash</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Fonder</item>
        <item name="android:windowSplashScreenBrandingImage">@drawable/kodhast_branding</item>
    </style>
</resources>
